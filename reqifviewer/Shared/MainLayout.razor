@using Pages.Index

@inherits LayoutComponentBase

@inject Radzen.DialogService RadzenDialogService

<PageTitle>ReqIF Viewer</PageTitle>

@* Radzen hosts stay until the pages are migrated to Blazor Blueprint. *@
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<BbSidebarProvider DefaultOpen="true">
    <SideMenu />

    <BbSidebarInset>
        <header class="app-header">
            <BbSidebarTrigger />
            <span class="app-header-title">ReqIF Viewer</span>

            <div class="app-header-actions">
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="this.OpenAbout">
                    <LucideIcon Name="info" Size="16" />
                    <span>About</span>
                </BbButton>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Href="https://github.com/STARIONGROUP/reqifviewer" Target="_blank" AriaLabel="ReqIF Viewer on GitHub" rel="noopener">
                    <LucideIcon Name="github" Size="18" />
                </BbButton>
                <BbDarkModeToggle Variant="ButtonVariant.Ghost" />
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </BbSidebarInset>
</BbSidebarProvider>

<BbToastProvider />
<BbDialogProvider />
<BbPortalHost />

@code {

    /// <summary>
    /// Show the About dialog
    /// </summary>
    /// <returns>
    /// an awaitable <see cref="Task"/>
    /// </returns>
    public async Task OpenAbout()
    {
        await this.RadzenDialogService.OpenAsync<AboutComponent>("About ReqIF Viewer", null, new Radzen.DialogOptions { Width = "700px", Height = "700px", Resizable = false, Draggable = false });
    }
}
