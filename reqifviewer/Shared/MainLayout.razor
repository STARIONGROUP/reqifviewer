@using Pages.Index

@inherits LayoutComponentBase

@implements IDisposable

@inject Radzen.DialogService RadzenDialogService
@inject NavigationManager NavigationManager

<PageTitle>ReqIF Viewer</PageTitle>

@* Radzen hosts stay until the pages are migrated to Blazor Blueprint. *@
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<BbSidebarProvider DefaultOpen="true" OpenMobile="this.isMobileSidebarOpen" OpenMobileChanged="this.OnMobileSidebarOpenChanged">
    <SideMenu />

    <BbSidebarInset>
        <header class="app-header">
            <BbSidebarTrigger />
            <span class="app-header-title">ReqIF Viewer</span>

            <div class="app-header-actions">
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="this.OpenAbout">
                    <LucideIcon Name="info" Size="16" />
                    <span>About</span>
                </BbButton>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Href="https://github.com/STARIONGROUP/reqifviewer" Target="_blank" AriaLabel="ReqIF Viewer on GitHub">
                    <LucideIcon Name="github" Size="18" />
                </BbButton>
                <BbDarkModeToggle Variant="ButtonVariant.Ghost" />
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </BbSidebarInset>
</BbSidebarProvider>

<BbToastProvider />
<BbDialogProvider />
<BbPortalHost />

@code {

    /// <summary>
    /// A value indicating whether the sidebar drawer is open on small screens
    /// </summary>
    private bool? isMobileSidebarOpen = false;

    /// <summary>
    /// Subscribes to navigation, so the sidebar drawer closes when a link in it is followed on a small screen
    /// </summary>
    protected override void OnInitialized()
    {
        this.NavigationManager.LocationChanged += this.OnLocationChanged;
    }

    /// <summary>
    /// Keeps track of the sidebar drawer being opened or closed on small screens
    /// </summary>
    /// <param name="open">a value indicating whether the drawer is open</param>
    private void OnMobileSidebarOpenChanged(bool open)
    {
        this.isMobileSidebarOpen = open;
    }

    /// <summary>
    /// Closes the sidebar drawer on small screens after navigating
    /// </summary>
    /// <param name="sender">the <see cref="NavigationManager"/></param>
    /// <param name="e">the <see cref="LocationChangedEventArgs"/></param>
    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        if (this.isMobileSidebarOpen == true)
        {
            this.isMobileSidebarOpen = false;
            this.InvokeAsync(this.StateHasChanged);
        }
    }

    /// <summary>
    /// Unsubscribes from navigation
    /// </summary>
    public void Dispose()
    {
        this.NavigationManager.LocationChanged -= this.OnLocationChanged;
    }

    /// <summary>
    /// Show the About dialog
    /// </summary>
    /// <returns>
    /// an awaitable <see cref="Task"/>
    /// </returns>
    public async Task OpenAbout()
    {
        await this.RadzenDialogService.OpenAsync<AboutComponent>("About ReqIF Viewer", null, new Radzen.DialogOptions { Width = "700px", Height = "700px", Resizable = false, Draggable = false });
    }
}
