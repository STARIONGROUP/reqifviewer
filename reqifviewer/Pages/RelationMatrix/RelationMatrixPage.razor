@using ReqIFSharp
@using reqifviewer.Components

@if (this.IsLoading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="margin-bottom: 20px" />
}
else if (this.reqIf == null)
{
    <RadzenHeading Size="H2" Text="Relation Matrix"></RadzenHeading>
    <p class="text-danger">No ReqIF with identifier <code>@this.Identifier</code> is loaded.</p>
}
else
{
    <RadzenHeading Size="H1" Text="@($"{this.reqIf.TheHeader.Title} - Relation Matrix")"></RadzenHeading>

    <RadzenCard Style="margin-bottom: 16px">
        <div class="row align-items-end">
            <div class="col-md-3">
                <RadzenLabel Text="Rows (Spec Object Type)" Component="rowTypeDropDown" />
                <RadzenDropDown Name="rowTypeDropDown" Data="@this.specObjectTypes" TextProperty="LongName" TValue="SpecObjectType"
                                @bind-Value="this.RowType" Change="@(_ => this.OnAxisChanged())" Style="width: 100%" />
            </div>
            <div class="col-md-1 text-center">
                <RadzenButton Icon="swap_horiz" ButtonStyle="ButtonStyle.Light"
                              Click="@this.OnSwapAxes" title="Swap row and column types" />
            </div>
            <div class="col-md-3">
                <RadzenLabel Text="Columns (Spec Object Type)" Component="colTypeDropDown" />
                <RadzenDropDown Name="colTypeDropDown" Data="@this.specObjectTypes" TextProperty="LongName" TValue="SpecObjectType"
                                @bind-Value="this.ColumnType" Change="@(_ => this.OnAxisChanged())" Style="width: 100%" />
            </div>
            <div class="col-md-3">
                <RadzenLabel Text="Relation Type" Component="relTypeDropDown" />
                <RadzenDropDown Name="relTypeDropDown" Data="@this.specRelationTypes" TextProperty="LongName" TValue="SpecRelationType"
                                @bind-Value="this.RelationType" Change="@(_ => this.OnAxisChanged())" Style="width: 100%" />
            </div>
            <div class="col-md-2">
                <RadzenCheckBox @bind-Value="this.ShowOnlyRelated"
                                Change="@((bool _) => this.OnAxisChanged())" Name="showOnlyRelated" />
                <RadzenLabel Text="Show only related" Component="showOnlyRelated" Style="margin-left: 6px" />
            </div>
        </div>
    </RadzenCard>

    <RelationMatrixComponent ReqIf="@this.reqIf"
                             RowType="@this.RowType"
                             ColumnType="@this.ColumnType"
                             RelationType="@this.RelationType"
                             ShowOnlyRelated="@this.ShowOnlyRelated"
                             ScrollKey="@this.BuildScrollKey()" />
}
